# Explicit unauthenticated public mode; no IdP or security Store is required.
# Use this file instead of server.env.example, in a clean shell.
LANTERN_PORT=6380
LANTERN_AUTH_MODE=off

# Optional public TLS; substitute real owned private files outside Git.
# LANTERN_TLS_CERT_FILE='/REPLACE_PRIVATE_DIRECTORY/tls/REPLACE_CERTIFICATE_CHAIN.pem'
# LANTERN_TLS_KEY_FILE='/REPLACE_PRIVATE_DIRECTORY/tls/REPLACE_PRIVATE_KEY.pem'
# Private replication separately requires signed membership and workload mTLS.
