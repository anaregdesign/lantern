# Operator worksheet only: no Lantern loader consumes these variable names.
# Private copies record provider-console selections; no resources are provisioned.
SERVICE_HTTPS_ORIGIN='https://replace-service-host.invalid'
ADMIN_HTTPS_ORIGIN='https://replace-admin-host.invalid'
API_AUDIENCE='REPLACE_LANTERN_API_AUDIENCE'

# Google Web client: browser exchange and backend native audience.
GOOGLE_WEB_CLIENT_ID='REPLACE_GOOGLE_WEB_CLIENT_ID'
GOOGLE_WEB_CLIENT_SECRET_FILE='/REPLACE_PRIVATE_DIRECTORY/google/REPLACE_WEB_CLIENT_SECRET.txt'
GOOGLE_OAUTH_CLIENT_JSON_FILE='/REPLACE_PRIVATE_DIRECTORY/google/REPLACE_DOWNLOADED_OAUTH_CLIENT.json'
GOOGLE_WEB_REDIRECT_URI='https://replace-admin-host.invalid/auth/callback/89a8000a68d759c68bfaeab5056d67342e97643511923e63702da58a9aac8f38'

# Google installed clients: exact actual build/signing registrations.
GOOGLE_ANDROID_CLIENT_ID='REPLACE_GOOGLE_ANDROID_CLIENT_ID'
ANDROID_PACKAGE='invalid.replace.application'
ANDROID_SIGNING_CERT_SHA1='REPLACE_ANDROID_SIGNING_CERT_SHA1'
ANDROID_SIGNING_CERT_SHA256='REPLACE_ANDROID_SIGNING_CERT_SHA256'
GOOGLE_IOS_CLIENT_ID='REPLACE_GOOGLE_IOS_CLIENT_ID'
IOS_BUNDLE_ID='invalid.replace.ios'
GOOGLE_IOS_REVERSED_CLIENT_ID='com.googleusercontent.apps.REPLACE_GOOGLE_IOS_CLIENT_ID_PREFIX'

# Apple: App ID is the registered Bundle identifier, not a numeric App Store ID.
APPLE_TEAM_ID='REPLACE_APPLE_TEAM_ID'
APPLE_KEY_ID='REPLACE_APPLE_KEY_ID'
APPLE_APP_ID='invalid.replace.ios'
APPLE_SERVICES_ID='invalid.replace.apple.web'
APPLE_WEBSITE_DOMAIN='replace-service-host.invalid'
APPLE_ANDROID_REDIRECT_URI='https://replace-service-host.invalid/auth/native/apple/callback/replace_apple_android'

# Operator-only signing and rotation inputs, never mobile/build configuration.
APPLE_SIGNING_KEY_FILE='/REPLACE_PRIVATE_DIRECTORY/apple/REPLACE_SIGN_IN_KEY.p8'
APPLE_IOS_CLIENT_SECRET_FILE='/REPLACE_PRIVATE_DIRECTORY/apple/REPLACE_IOS_CLIENT_SECRET.jwt'
APPLE_ANDROID_CLIENT_SECRET_FILE='/REPLACE_PRIVATE_DIRECTORY/apple/REPLACE_ANDROID_CLIENT_SECRET.jwt'
