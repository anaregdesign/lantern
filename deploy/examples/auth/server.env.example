# Same human-authored configuration for provision-security, init-security and
# every ordinary start. Replace all placeholders privately; never log this value.
# Identity material is durable keys/trust only, never a saved runtime config.
LANTERN_PORT=6380
LANTERN_AUTH_MODE=oidc
LANTERN_SECURITY_CONFIG_JSON='{"public_origin":"https://fake-admin.example.invalid:6380","material_root":"/REPLACE_PRIVATE_MATERIAL_DIRECTORY","persistence_root":"/REPLACE_PRIVATE_STATE_DIRECTORY","target_platform":"linux","tls_termination":"server","initial_admin":{"issuer":"https://accounts.google.com","subject":"FAKE_VERIFIED_ADMIN_SUBJECT"},"nodes":[{"name":"node-1","control_origin":"https://lantern-0:6381","data_origin":"https://lantern-0:6382","control_listen":":6381","data_listen":":6382"}],"issuers":[{"issuer":"google","client_id":"FAKE_GOOGLE_WEB_CLIENT_ID","client_secret":"FAKE_CLIENT_SECRET_DO_NOT_USE"}],"tls":{"certificate_pem":"FAKE_PUBLIC_TLS_CERTIFICATE_PEM","private_key_pem":"FAKE_PUBLIC_TLS_PRIVATE_KEY_PEM"}}'
