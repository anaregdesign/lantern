# POSIX shell input for the existing Server loaders; see README.md.
# Replace private paths and origins outside Git. No credential bytes belong here.
LANTERN_PORT=6380
LANTERN_TLS_CERT_FILE='/REPLACE_PRIVATE_DIRECTORY/tls/REPLACE_CERTIFICATE_CHAIN.pem'
LANTERN_TLS_KEY_FILE='/REPLACE_PRIVATE_DIRECTORY/tls/REPLACE_PRIVATE_KEY.pem'

LANTERN_AUTH_MODE=oidc
LANTERN_SECURITY_CONFIG_FILE='/REPLACE_PRIVATE_DIRECTORY/REPLACE_NODE.json'
# For intact existing state only; fresh requires independent new provisioning.
LANTERN_SECURITY_STORE_MODE=resume
LANTERN_OIDC_BROWSER_ORIGIN='https://replace-admin-host.invalid'
LANTERN_OIDC_SECRET_BINDINGS='{"replace_apple_android":{"issuer":"https://appleid.apple.com","client_id":"invalid.replace.apple.web","token_origin":"https://appleid.apple.com","path":"/REPLACE_PRIVATE_DIRECTORY/apple/REPLACE_ANDROID_CLIENT_SECRET.jwt"},"replace_apple_ios":{"issuer":"https://appleid.apple.com","client_id":"invalid.replace.ios","token_origin":"https://appleid.apple.com","path":"/REPLACE_PRIVATE_DIRECTORY/apple/REPLACE_IOS_CLIENT_SECRET.jwt"},"replace_google_web":{"issuer":"https://accounts.google.com","client_id":"REPLACE_GOOGLE_WEB_CLIENT_ID","token_origin":"https://oauth2.googleapis.com","path":"/REPLACE_PRIVATE_DIRECTORY/google/REPLACE_WEB_CLIENT_SECRET.txt"}}'

# Optional, separately reviewed trust inputs; never disable TLS verification.
# LANTERN_TLS_CLIENT_CA_FILE='/REPLACE_PRIVATE_DIRECTORY/tls/REPLACE_PUBLIC_CLIENT_CA.pem'
# LANTERN_OIDC_ROOT_CA_FILE='/REPLACE_PRIVATE_DIRECTORY/tls/REPLACE_IDP_CA.pem'
# LANTERN_OIDC_TRUSTED_PROXY_IPS='["REPLACE_EXACT_GATEWAY_IP"]'
# Do not add legacy writer/bootstrap/clock settings or a registration policy.
