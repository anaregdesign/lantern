{
  "public_origin": "https://fake-admin.example.invalid:6380",
  "persistence_root": "/state",
  "target_platform": "linux",
  "tls_termination": "server",
  "initial_admin": {
    "issuer": "https://accounts.google.com",
    "subject": "FAKE_VERIFIED_ADMIN_SUBJECT"
  },
  "nodes": [
    {
      "name": "node-1",
      "control_origin": "https://lantern-0:6381",
      "data_origin": "https://lantern-0:6382",
      "control_listen": ":6381",
      "data_listen": ":6382"
    }
  ],
  "issuers": [
    {
      "issuer": "google",
      "client_id": "FAKE_GOOGLE_WEB_CLIENT_ID",
      "client_secret": "FAKE_CLIENT_SECRET_DO_NOT_USE"
    }
  ],
  "tls": {
    "certificate_pem": "FAKE_PUBLIC_TLS_CERTIFICATE_PEM",
    "private_key_pem": "FAKE_PUBLIC_TLS_PRIVATE_KEY_PEM"
  }
}
