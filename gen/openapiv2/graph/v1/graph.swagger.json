              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "PutEdgeRequest overwrites each (tail, head) pair, replacing any existing\nweight and expiration. This operation is idempotent.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1PutEdgeRequest"
            }
          }
        ],
        "tags": [
          "LanternService"
        ]
      }
    },
