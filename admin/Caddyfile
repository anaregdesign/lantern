# SPA routes (/cli, /ops) follow the fixed Server/BFF and diagnostics routes.
# API failures are never rewritten to index.html. OIDC operators expose this
# host over HTTPS; reverse proxies preserve its original public Host/scheme.
{
	admin off
	persist_config off
}

{$LANTERN_ADMIN_LISTEN::8080} {
	encode zstd gzip
	handle /healthz {
		respond "ok" 200
	}
	import /etc/caddy/conf.d/*.caddy
	handle {
		root * /srv
		@hashed path /assets/* /favicon.ico
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}
