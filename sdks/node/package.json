{
  "name": "lantern-sdk",
  "version": "0.10.0",
  "description": "Official TypeScript client SDK for Lantern — an in-memory graph KVS, over Connect (HTTP/2).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anaregdesign/lantern.git",
    "directory": "sdks/node"
  },
  "homepage": "https://github.com/anaregdesign/lantern/tree/main/sdks/node",
  "bugs": {
    "url": "https://github.com/anaregdesign/lantern/issues"
  },
  "keywords": [
    "lantern",
    "graph",
    "kvs",
    "connect",
    "connectrpc",
    "client",
    "sdk"
  ],
  "scripts": {
    "codegen": "bash scripts/codegen.sh",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "example:typecheck": "tsc -p tsconfig.example.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2",
    "@connectrpc/connect": "^2",
    "@connectrpc/connect-node": "^2",
    "@connectrpc/connect-web": "^2"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.12",
    "@eslint/js": "^9.0.0",
    "@types/bun": "^1.1.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
