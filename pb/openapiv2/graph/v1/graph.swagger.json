    "v1PutEdgesRequest": {
      "type": "object",
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Edge"
          }
        }
      },
      "description": "PutEdgesRequest overwrites each (tail, head) pair, replacing any existing\nweight and expiration. This operation is idempotent."
    },
    "v1PutEdgesResponse": {
      "type": "object",
      "properties": {
        "written": {
          "type": "integer",
          "format": "int32",
