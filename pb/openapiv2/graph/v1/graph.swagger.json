    "/v1/vertices/scan": {
      "post": {
        "summary": "ScanVertices streams vertices whose key starts with the given prefix in\nascending order, page by page. Plural-only — prefix scan is inherently\nplural.",
        "operationId": "LanternService_ScanVertices",
        "responses": {
          "200": {
            "description": "A successful response.",
