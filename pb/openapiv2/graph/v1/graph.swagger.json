      "type": "string",
      "enum": [
        "OPTIMIZATION_UNSPECIFIED",
        "OPTIMIZATION_MINIMUM_SPANNING_TREE",
        "OPTIMIZATION_MAXIMUM_SPANNING_TREE",
        "OPTIMIZATION_SHORTEST_PATH_TREE",
        "OPTIMIZATION_SHORTEST_PATH_TREE_INVERSE"
      ],
      "default": "OPTIMIZATION_UNSPECIFIED"
    },
    "v1PutEdgeResponse": {
      "type": "object"
